# ===========================================================================
# LOGISTIK HANDAYANI — TAMBAHAN .env PRODUKSI untuk SSO (Opsi B)
# ===========================================================================
#
# ⚠️  INI BUKAN file .env lengkap. Ini HANYA BLOK SSO yang harus DITAMBAHKAN
#     ke bagian bawah `.env` produksi Logistik yang SUDAH ADA.
#
# JANGAN ubah/timpa `APP_*`, `DB_*`, `MAIL_*`, `SESSION_*`, `APP_KEY`, dsb.
# yang sudah benar di produksi — itu bisa mematikan aplikasi.
#
# Cara pakai:
#   1. Deploy branch `feature/sso-connector` (berisi kode SSO) ke server.
#   2. Buka `.env` produksi, TAMBAHKAN baris di bawah bagian "SSO" ini.
#   3. Isi SSO_CLIENT_ID & SSO_CLIENT_SECRET dari Portal (app "logistik").
#   4. php artisan config:cache route:cache
#
# Catatan: perubahan `.env.example` pada branch SSO bersifat ADDITIVE
# (hanya menambah 9 baris di akhir file) — tidak mengubah variabel lain.
# ===========================================================================

# --- SSO (Handayani Portal) — Opsi B -------------------------------------
# Default OFF agar login langsung tetap jalan bila Portal belum siap.
# Nyalakan (true) setelah Portal live & kredensial terisi.
SSO_ENABLED=true

# WAJIB https:// di produksi (penjaga kode akan menolak http:// di non-lokal).
SSO_PORTAL_BASE_URL=https://portal.handayani.my.id

# Kredensial dari Portal → menu Aplikasi → app "logistik" → Buat Client.
SSO_CLIENT_ID=<client_id dari Portal>
SSO_CLIENT_SECRET=<client_secret dari Portal — HANYA tampil sekali>

# Harus SAMA PERSIS dengan Redirect URI yang terdaftar di Portal (exact match).
SSO_REDIRECT_URI=https://handayani.my.id/sso/callback

# TTL state/verifier (detik). Default 300.
SSO_STATE_TTL=300

# Timeout HTTP ke Portal (detik). Default 10.
SSO_HTTP_TIMEOUT=10
