APP_NAME="Logistik Taman Air Handayani Paiton"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mutasi_backend
DB_USERNAME=root
DB_PASSWORD=

SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# db docker
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=laravel
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
FOTO_BARANG_PROCESSING_MODE=after_response
FOTO_BARANG_PROCESSING_QUEUE=default

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SSO (Handayani Portal) - Opsi B. Isi client_id/secret dari Portal.
SSO_ENABLED=false
SSO_PORTAL_BASE_URL=https://portal.handayani.my.id
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://handayani.my.id/sso/callback
SSO_STATE_TTL=300
SSO_HTTP_TIMEOUT=10

# Asisten AI (chat & voice). Default OFF.
# Aktifkan dengan AI_ENABLED=true dan isi AI_API_KEY dari gateway (KryptonLab).
# Endpoint terverifikasi: https://api.kryptonlab.id/v1 (OpenAI-compatible).
AI_ENABLED=false
AI_PROVIDER=kryptonlab
AI_BASE_URL=https://api.kryptonlab.id/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash
AI_CHAT_PATH=/chat/completions
AI_MODELS_PATH=/models
AI_TIMEOUT=60
AI_CONNECT_TIMEOUT=10
AI_RETRY_TIMES=2
AI_RETRY_SLEEP_MS=500
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2
AI_MAX_TOOL_ITERATIONS=10
# Batas ingatan/riwayat percakapan yang dikirim ke model (dilonggarkan agar AI
# tidak mudah lupa; sesuaikan bila ingin lebih hemat token).
AI_HISTORY_LIMIT=80
# Anggaran token harian (indikator di halaman pemakaian, bukan hard-stop).
AI_BUDGET_DAILY_TOKENS=1000000
# Penghematan konteks (jangan terlalu kecil agar AI tetap konteks-paham).
AI_CONTEXT_KNOWLEDGE_LIMIT=30
AI_CONTEXT_OLDER_SUMMARY_LINES=12
AI_CONTEXT_DRAFT_ITEM_CAP=60

# --- Provider: lokal (Xcode AI sendiri) vs cloud (API key cadangan) ---
# AI_DRIVER=cloud  → hanya cloud (perilaku lama; default)
# AI_DRIVER=local  → hanya model lokal (server sendiri, tanpa API key cloud)
# AI_DRIVER=auto   → coba lokal dulu; gagal → otomatis pindah ke cloud
AI_DRIVER=cloud
# Server model lokal OpenAI-compatible (Ollama/vLLM/LM Studio/llama.cpp).
# Model WAJIB mendukung tool-calling.
AI_LOCAL_LABEL="Xcode AI (Lokal)"
AI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AI_LOCAL_API_KEY=local
AI_LOCAL_MODEL=qwen2.5:14b-instruct
AI_LOCAL_CHAT_PATH=/chat/completions
AI_LOCAL_MODELS_PATH=/models
AI_LOCAL_PRIMARY=true

# --- Distilasi: rekam contoh untuk fine-tune model lokal (opsional) ---
AI_TRAINING_CAPTURE=true
AI_TRAINING_ONLY_WITH_TOOLS=true
# Saat menjawab dengan model LOKAL, apakah data latih tetap disimpan? (default false)
AI_TRAINING_LOCAL_ENABLED=false

# --- Pengaturan profil lokal dari UI (database) ---
# Bila true: base_url/model/api_key lokal & izin rekam data bisa diubah dari menu
# "Pengaturan Asisten AI" tanpa menyentuh .env. Kosong = jatuh ke nilai di atas.
AI_PROVIDER_SETTINGS_FROM_DB=true

# --- Kecerdasan lokal (deterministik, tanpa LLM) ---
# Tangani perintah belanja JELAS tanpa memanggil API model (hemat token & akurat).
# Bila ragu, otomatis diteruskan ke model API.
AI_LOCAL_INTELLIGENCE=true

AI_VOICE_LANG=id-ID
AI_VOICE_RATE=1.0
AI_VOICE_AUTO_SPEAK=false
AI_VOICE_READ_SUMMARY=true
AI_VOICE_NAMES=google indonesian,andika,gadis,damayanti,indonesian
# Mikrofon tetap hidup selama sesi (tidak terpotong saat jeda). Default true.
AI_VOICE_CONTINUOUS=true
# Jeda (ms) sebelum mic dinyalakan ulang bila browser memutusnya. 0 = secepatnya.
AI_VOICE_RESTART_DELAY_MS=0
